execute_process(COMMAND "${EXPERIMENT}" --sensitivity "${CSV}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0" AND NOT result STREQUAL "1")
  message(FATAL_ERROR "Sensitivity command failed to run: ${result}")
endif()

file(STRINGS "${CSV}" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 41)
  message(FATAL_ERROR "Expected one header and 40 trial rows, got ${row_count}")
endif()
list(REMOVE_AT rows 0)
set(keys)
set(has_unfinished FALSE)
foreach(row IN LISTS rows)
  if(NOT row MATCHES "^(reference|output_middle|mix_longer|detect_longer),([1-5]),60,25,[0-9]+,[0-9]+,[0-9]+,[0-9]+,(immediate|static_batch),(complete|timeout|failed),")
    message(FATAL_ERROR "Invalid trial row: ${row}")
  endif()
  set(profile "${CMAKE_MATCH_1}")
  list(APPEND keys "${profile}/${CMAKE_MATCH_2}/${CMAKE_MATCH_3}")
  set(status "${CMAKE_MATCH_4}")
  if(status STREQUAL "complete")
    if(NOT row MATCHES ",complete,([1-9][0-9]*,)([1-9][0-9]*,)([1-9][0-9]*,)([1-9][0-9]*,)([1-9][0-9]*,)100,100,\"\"$")
      message(FATAL_ERROR "Completed trial is missing milestones or arrivals: ${row}")
    endif()
  else()
    set(has_unfinished TRUE)
    if(profile STREQUAL "reference" OR NOT row MATCHES ",\"[^\"]+\"$")
      message(FATAL_ERROR "Reference did not complete or error entry is missing: ${row}")
    endif()
  endif()
endforeach()
list(REMOVE_DUPLICATES keys)
list(LENGTH keys unique_count)
if(NOT unique_count EQUAL 40 OR
   (has_unfinished AND NOT result STREQUAL "1") OR
   (NOT has_unfinished AND NOT result STREQUAL "0"))
  message(FATAL_ERROR "Missing trial pairs or exit status disagrees with the CSV")
endif()
